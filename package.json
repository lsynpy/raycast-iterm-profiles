{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "raycast-iterm-profiles",
  "title": "iTerm Profiles",
  "description": "Open iTerm2 with a specific profile",
  "icon": "icon.png",
  "author": "kt",
  "license": "MIT",
  "categories": [
    "Applications",
    "Developer Tools"
  ],
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "open-iterm-profile",
      "title": "Open iTerm Profile",
      "description": "Open a new iTerm2 window with a selected profile",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.90.0",
    "@raycast/utils": "^1.18.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "typescript": "^5.7.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "eslint src/",
    "fmt": "prettier --write '**/*.{ts,tsx,json,md}'",
    "prepare": "husky"
  }
}
